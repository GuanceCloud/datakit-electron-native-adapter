# Browser RUM (Electron Renderer)
VITE_GUANCE_APPLICATION_ID=native-bridge
VITE_GUANCE_CLIENT_TOKEN=
VITE_GUANCE_SITE=
VITE_GUANCE_DATAKIT_ORIGIN=http://127.0.0.1:9529
VITE_GUANCE_SERVICE=orbitdesk-managed-web
VITE_GUANCE_ENV=development
VITE_GUANCE_SESSION_REPLAY=true
VITE_GUANCE_ALLOWED_TRACING_URL=

# Native RUM (managed by the Electron Adapter)
GUANCE_NATIVE_APP_ID=your_native_application_id
GUANCE_NATIVE_CLIENT_TOKEN=
GUANCE_NATIVE_DATAWAY_URL=
GUANCE_NATIVE_DATAKIT_URL=http://127.0.0.1:9529
GUANCE_NATIVE_SERVICE=orbitdesk-electron
GUANCE_NATIVE_ENV=development
GUANCE_NATIVE_DEBUG=true
GUANCE_NATIVE_ACTION_TRACKING=true
GUANCE_NATIVE_SESSION_REPLAY=true
GUANCE_NATIVE_SESSION_REPLAY_SAMPLE_RATE=1
