{
  "name": "@cloudcare/electron-native-adapter",
  "version": "0.0.0-local",
  "private": true,
  "description": "Electron adapter for CloudCare native desktop RUM SDKs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/GuanceCloud/datakit-electron-native-adapter.git"
  },
  "type": "commonjs",
  "main": "main/index.cjs",
  "bin": {
    "ft-electron-native": "bin/ft-electron-native.mjs"
  },
  "exports": {
    ".": "./main/index.cjs",
    "./main": "./main/index.cjs",
    "./packaging/windows": "./packaging/windows.cjs",
    "./preload/install": "./preload/install.cjs",
    "./preload/standalone": "./preload/standalone.cjs"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "bin",
    "core",
    "main",
    "preload",
    "internal",
    "platform",
    "packaging",
    "native/darwin/README.md",
    "native/darwin/scripts",
    "native/win32-x64"
  ],
  "scripts": {
    "build:native:macos:managed": "node native/darwin/scripts/build-native.mjs",
    "build:native:macos:universal": "node native/darwin/scripts/build-universal.mjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "clean:native:macos": "node native/darwin/scripts/clean.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run check:syntax && npm test",
    "pack:windows": "node scripts/pack-windows.cjs",
    "publish:windows": "node scripts/publish-windows.cjs",
    "verify:windows:tarballs": "node scripts/verify-windows-tarballs.cjs",
    "verify:native:macos": "node native/darwin/scripts/verify-runtime.mjs"
  },
  "peerDependencies": {
    "electron": "^22.3.27 || 43.x"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.17.1"
  }
}
